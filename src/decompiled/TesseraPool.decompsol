    // [ANN] SET DEFAULT FEE (operator only). The argument is obfuscated: varg0 = ~(0xdeadbeef.. ^ newValue) where newValue is a 96-bit
    //       value whose LOW 64 bits must equal block.number ("block-bound" tx, i.e. only valid in the intended block).
    //       The decoded value's top 32 bits (<<96 -> bits 160..191 of slot 0x32) become the DEFAULT fee ppm (read via 0x760f6a4c).
    //       => this is the cheap per-block fee flip: raise default fee at start of block, drop it at end of block.
    //       [PAPER] Sec 7.4 "Spoofing", Fig. 7a / Fig. 11: default-fee decreases cluster in the last tenth of the block, increases in the first.
    function 0x1667d875(uint96 varg0) public nonPayable {
        require(msg.data.length - 4 >= 32);
        require(!(msg.sender - address(_disableTrading)), NotOperator());
        if (uint64(block.number) == uint64(~(0xdeadbeefdeadbeefdeadbeef ^ varg0))) {
            _disableTrading = 0xffffffff0000000000000000000000000000000000000000 & ~(0xdeadbeefdeadbeefdeadbeef ^ varg0) << 96 | 0xffffffffffffffff00000000ffffffffffffffffffffffffffffffffffffffff & _disableTrading;
            exit;
        } else {
            // [ANN] wrong block => silent no-op (prevents stale default-fee txs from landing late)
            exit;
        }
    }

    function multiSigOwner() public nonPayable {
        require(msg.data.length - 4 >= 0);
        return _multiSigOwner;
    }

