            require(10 ** 6 <= 10 ** 6 + uint32(uint24(stor_0 >> 56)), Panic(17)); // arithmetic overflow or underflow
            v0 = _SafeMul(uint128(stor_0 >> 80), 10 ** 6 + uint32(uint24(stor_0 >> 56)));
            require(v0 <= v0 + 10 ** 6, Panic(17)); // arithmetic overflow or underflow
            require(0xf423f + v0 <= v0 + 10 ** 6, Panic(17)); // arithmetic overflow or underflow
