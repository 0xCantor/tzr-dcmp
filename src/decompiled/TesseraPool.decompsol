    }

    // [ANN] poolState(): full public snapshot used by indexers: both accumulators, fee/age/priority params, both ladders.
    function poolState() public nonPayable {
        require(msg.data.length - 4 >= 0);
        v0 = 0x25cc();
        v1 = new struct(2);
        require(!((v1 + 64 > uint64.max) | (v1 + 64 < v1)), Panic(65)); // failed memory allocation (too much memory)
        v2 = 0x2629();
        v1.word0 = v2;
        v3 = 0x26a2();
        v1.word1 = v3;
        0x271b(v1.word0, MEM[64] + 448);
        0x271b(v1.word1, MEM[64] + 2368);
        return _poolState, stor_4, stor_5_0_3, stor_5_4_7, stor_5_8_8, stor_5_9_9, uint64(v0.word0), uint64(v0.word1), uint32(v0.word2), uint32(v0.word3), stor_7_0_3, stor_7_4_4, stor_7_5_8, stor_7_9_12;
    }

    // Note: The function selector is not present in the original solidity code.
    // However, we display it for the sake of completeness.

    // [ANN] SELECTOR TABLE. IMPORTANT: there is NO dispatch entry for the cheap anchor/spread update (~27k gas). In the paper this
    //       is the hot path (p,s update every ~0.56 blocks). It must therefore be handled BEFORE this dispatcher, e.g. a raw-calldata
    //       fast path keyed on the operator caller / calldata length, which Dedaub did not lift. The write target is stor_0.
    //       => Trace one real update tx (operator -> pool) to recover the calldata layout.
    function __function_selector__( function_selector) public payable {
        MEM[64] = 128;
        if (msg.data.length >= 4) {
            if (0x329dd62 == function_selector >> 224) {
                multiSigOwner();
            } else if (0x1667d875 == function_selector >> 224) {
                0x1667d875();
            } else if (0x17700f01 == function_selector >> 224) {
                disableTrading();
            } else if (0x209dab1e == function_selector >> 224) {
                0x209dab1e();
            } else if (0x21523c7e == function_selector >> 224) {
                0x21523c7e();
            } else if (0x217a4b70 == function_selector >> 224) {
                quoteToken();
            } else if (0x2c88026b == function_selector >> 224) {
                0x2c88026b();
            } else if (0x3c0ae986 == function_selector >> 224) {
                0x3c0ae986();
            } else if (0x3d253f20 == function_selector >> 224) {
                0x3d253f20();
            } else if (0x43db5616 == function_selector >> 224) {
                0x43db5616();
            } else if (0x4a036fcb == function_selector >> 224) {
                0x4a036fcb();
            } else if (0x4ada218b == function_selector >> 224) {
                tradingEnabled();
            } else if (0x4c7c47b7 == function_selector >> 224) {
                0x4c7c47b7();
            } else if (0x5b7e30e5 == function_selector >> 224) {
                0x5b7e30e5();
            } else if (0x641ad8a9 == function_selector >> 224) {
                poolState();
            } else if (0x67107049 == function_selector >> 224) {
                0x67107049();
            } else if (0x75e8422f == function_selector >> 224) {
                0x75e8422f();
            } else if (0x760f6a4c == function_selector >> 224) {
                0x760f6a4c();
            } else if (0x7af3c3d6 == function_selector >> 224) {
                0x7af3c3d6();
            } else if (0x7bcffd54 == function_selector >> 224) {
                0x7bcffd54();
            } else if (0x8a8c523c == function_selector >> 224) {
                enableTrading();
            } else if (0x8f05e71b == function_selector >> 224) {
                0x8f05e71b();
            } else if (0x9ed3c90c == function_selector >> 224) {
                isInitialised();
            } else if (0xa9977bfe == function_selector >> 224) {
                0xa9977bfe();
            } else if (0xc55dae63 == function_selector >> 224) {
                baseToken();
            } else if (0xdba310cf == function_selector >> 224) {
                0xdba310cf();
            } else if (0xdc4c90d3 == function_selector >> 224) {
                poolManager();
            } else if (0xece42d7f == function_selector >> 224) {
                0xece42d7f();
            } else {
                exit;
            }
        } else {
            // [ANN] calldata < 4 bytes => exit (no revert, no fallback). The raw update fast-path is probably elsewhere (see above).
            exit;
        }
    }
}
