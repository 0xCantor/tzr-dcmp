    // [ANN] 0x4494(params, refBlock, currentBlock): AGE FEE / QUOTE EXPIRY.
    //       age = currentBlock - refBlock (if currentBlock < refBlock -> returns uint32.max = invalid).
    //       params.word0 = expiry age: age >= expiry            -> uint32.max (NO FILL)
    //       params.word1 = grace:      age <  grace             -> 0 (no penalty)
    //       else n = age - grace + 1; fee = coef * n * n (uint32, overflow-guarded), capped at params.word3 (cap), saturating to cap on overflow.
    //       [PAPER] "no freshness penalty for a short grace period, an increasingly worse price thereafter, and no fill at all once the quote expires."
    //       NB: Dedaub merged the two mulitplications; real shape = quadratic in age.
    function 0x4494(struct(4) varg0, uint256 varg1, uint256 varg2) private {
